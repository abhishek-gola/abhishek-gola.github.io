---
import Layout from '../layouts/Layout.astro';
import Recordings from '../components/Recordings.astro';
import { proposedTalks, speakerBio } from '../data/speaking';
import { profile } from '../data/site';
---
<Layout title="Talks & Speaking" description="Watch Abhishek Gola’s four OpenCV recordings and explore proposed talks on inference performance, DNN architecture and open-source contribution.">
  <section class="page-intro container"><span class="eyebrow">SPEAKING / COMMUNITY / MENTORSHIP</span><h1>Technical depth.<br/><span class="blue-text">Shared understanding.</span></h1><p>OpenCV sessions and proposed conference talks, grounded in implementation, review and the engineering decisions in between.</p><a class="text-link" href={`mailto:${profile.email}?subject=Speaking%20invitation`}>Discuss a speaking invitation ↗</a></section>
  <section class="container speaker-section"><div class="section-heading"><h2>Previous recordings</h2></div><Recordings/><p class="recording-footnote">Published on OpenCV’s YouTube channel. Team sessions include multiple participants; month labels refer to recording publication.</p></section>
  <section class="topics-section"><div class="container speaker-section"><span class="eyebrow">PROPOSED SESSIONS</span><h2>Talk topics for your audience.</h2><p class="talks-lead">These session outlines are available for discussion. Duration and technical depth can be adapted with the organizer.</p>{proposedTalks.map(talk => <article class="talk-proposal" id={`talk-${talk.number}`}><span class="topic-number mono">{talk.number}</span><div><h3>{talk.title}: {talk.subtitle}</h3><p>{talk.description}</p><div class="topic-format"><span>{talk.audience}</span><span>{talk.level}</span><span>{talk.duration}</span></div><h4>What the audience takes away</h4><ul>{talk.takeaways.map(point => <li>{point}</li>)}</ul><a class="text-link" href={`mailto:${profile.email}?subject=${encodeURIComponent('Talk inquiry: '+talk.title)}`}>Discuss this session ↗</a></div></article>)}</div></section>
  <section class="container speaker-section organizer-section"><div><span class="eyebrow">FOR ORGANIZERS</span><h2>Speaker information.</h2><a class="text-link" href="/speaker-bio.txt" download>Download speaker bio ↓</a></div><div><p>{speakerBio}</p><div class="availability"><h3>Location & travel</h3><p>Based in Bengaluru, India. In-person events outside Bengaluru require travel and accommodation support.</p></div><a class="text-link" href={`mailto:${profile.email}`}>{profile.email} ↗</a></div></section>
  <section class="container speaker-section"><span class="eyebrow">COMMUNITY</span><h2>Mentoring the next contribution.</h2><p class="talks-lead">I mentor OpenCV Google Summer of Code projects, helping contributors navigate technical decisions, code review and integration. The public project list records mentors and project scope.</p><a class="text-link" href="https://github.com/opencv/opencv/wiki/GSoC_2026">OpenCV GSoC 2026 project list ↗</a></section>
</Layout>
