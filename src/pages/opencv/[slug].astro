---
import Layout from '../../layouts/Layout.astro';import {work} from '../../data/site';
export function getStaticPaths(){return work.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props;const source=`https://github.com/opencv/opencv/pull/${item.number}`;
---
<Layout title={item.short} description={item.description}><div id="top"></div><section class="page-intro case-intro container"><a class="eyebrow" href="/opencv/">← OPENCV / CASE STUDY</a><h1>{item.title}</h1><p>{item.description}</p><div class="tags">{item.tags.map(t=><span>{t}</span>)}</div><div class="case-meta"><span>Merged {item.date}</span><span>opencv/opencv · #{item.number}</span><span>Abhishek Gola · contributor</span></div></section><div class="case-layout container"><aside class="toc" aria-label="On this page"><span class="eyebrow">IN THIS CASE STUDY</span><a href="#problem">The problem</a><a href="#contribution">Contribution & credit</a><a href="#architecture">Design & trade-offs</a><a href="#validation">Validation & limits</a><a href="#lessons">Engineering lesson</a><a href="#source">Source evidence</a></aside><article class="prose"><h2 id="problem">The problem</h2><p>{item.problem}</p><h2 id="contribution">Contribution & credit</h2><p>{item.role}</p><h2 id="architecture">Design & trade-offs</h2><p>{item.approach}</p><figure><div class="architecture">{item.steps.map((step,i)=><><span>{step}</span>{i !== item.steps.length - 1 && <i aria-hidden="true">→</i>}</>)}</div><figcaption class="diagram-caption">Conceptual flow. See the source changes for implementation details.</figcaption></figure><h2 id="validation">Validation & limitations</h2><p>{item.validation}</p><p>{item.limits}</p><div class="case-outcome"><span class="eyebrow">VERIFIABLE OUTCOME</span><strong>{item.outcome}</strong><p>The merged change is the outcome reported here. No new benchmark was run for this site.</p></div><h2 id="lessons">Engineering lesson</h2><p>{item.lesson}</p><h2 id="source">Inspect the evidence</h2><div class="source-actions"><a class="button primary" href={source} target="_blank" rel="noreferrer">Pull request #{item.number} ↗</a><a class="button outline" href={`${source}/files`} target="_blank" rel="noreferrer">Implementation diff ↗</a></div>{item.number==='29341'&&<p>Related work: <a href="https://github.com/opencv/opencv_contrib/pull/4166">opencv_contrib #4166</a>. Co-author: <a href="https://github.com/Akansha-977">@Akansha-977</a>.</p>}<p class="note">Editorial synthesis of the linked public record, checked November 1, 2026.</p></article></div></Layout>
